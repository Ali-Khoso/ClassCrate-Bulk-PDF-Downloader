{
  "manifest_version": 3,
  "name": "ClassCrate — Bulk PDF Downloader",
  "short_name": "ClassCrate",
  "description": "Download your accessible Google Classroom PDF, PPTX, DOCX, and other attachments by subject in their original formats.",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "identity",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://classroom.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open ClassCrate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_CHROME_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/classroom.courses.readonly",
      "https://www.googleapis.com/auth/classroom.courseworkmaterials.readonly",
      "https://www.googleapis.com/auth/classroom.announcements.readonly",
      "https://www.googleapis.com/auth/classroom.coursework.me.readonly",
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  },
  "key": ""
}
